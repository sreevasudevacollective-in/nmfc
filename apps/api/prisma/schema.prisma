// NMFC data model.
//
// Shape and rationale: docs/system-design.md §3 and docs/decisions/0003-fighter-accounts.md.
// Two rules worth knowing before editing:
//
//   1. A fighter's win/loss record is DERIVED from Fight rows, never stored (§3.3 option A).
//      The only counters here are `prior*`, which hold pre-NMFC history that our Fight
//      table cannot know about.
//   2. Private personal data belongs in FighterProfile, never on Fighter. The public API
//      never queries FighterProfile, so private fields cannot leak by omission (ADR 0003 §3).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

// OPEN (system-design §14.4): these are placeholder divisions. NMFC's actual
// weight classes, and whether women's divisions are needed, are still unconfirmed.
enum WeightClass {
  FLYWEIGHT
  BANTAMWEIGHT
  FEATHERWEIGHT
  LIGHTWEIGHT
  WELTERWEIGHT
  MIDDLEWEIGHT
  LIGHT_HEAVYWEIGHT
  HEAVYWEIGHT
}

enum EventStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum FightStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

/// Explicit outcome, so "no winner" is never ambiguous between draw, no-contest,
/// and not-yet-fought. WIN_A / WIN_B identify the winner by their side of the bout,
/// which cannot point at a fighter who isn't in the fight.
enum FightOutcome {
  WIN_A
  WIN_B
  DRAW
  NO_CONTEST
}

enum Role {
  ADMIN
  FIGHTER
  /// Holds an account and an application, but no Fighter record yet (ADR 0004).
  APPLICANT
}

enum ClaimStatus {
  UNCLAIMED
  INVITED
  CLAIMED
}

/// Collected for records, medical context, and future gender-scoped divisions.
/// Divisions are men's-only in v1, so this does not yet scope WeightClass.
enum Gender {
  MALE
  FEMALE
  OTHER
}

enum Stance {
  ORTHODOX
  SOUTHPAW
  SWITCH
}

/// Background disciplines a fighter brings in. NMFC competes under a single ruleset,
/// so this describes experience — it does not scope events, bouts or divisions.
enum Discipline {
  BOXING
  MUAY_THAI
  KICKBOXING
  SANDA
  KARATE
  TAEKWONDO
  MMA
  BJJ
  WRESTLING
  OTHER
}

enum ConditioningLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ELITE
}

/// The §7 self-assessment checklist. Fixed list, no per-item data, so it is stored as
/// an array on Application rather than a child table.
enum FightAttribute {
  PUNCHING_POWER
  HAND_SPEED
  KICKING_POWER
  KICKING_SPEED
  FOOTWORK
  COUNTER_STRIKING
  COMBINATION_STRIKING
  DEFENCE
  FIGHT_IQ
  CARDIO
  DURABILITY
  EXPLOSIVENESS
  PRESSURE_FIGHTING
  TECHNICAL_STRIKING
}

enum VideoKind {
  FULL_FIGHT
  HIGHLIGHT
  PAD_WORK
  HEAVY_BAG
  SHADOWBOXING
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  SHORTLISTED
  ACCEPTED
  REJECTED
  WITHDRAWN
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

/// Thin local mirror of a Supabase Auth user (ADR 0002). `id` is the Supabase UID —
/// no password or session data lives here.
model User {
  id        String   @id
  email     String   @unique
  role      Role     @default(APPLICANT)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fighter      Fighter?
  /// Re-application is allowed. "Only one open at a time" is a service invariant —
  /// a database constraint would block legitimate reapplication after a rejection.
  applications Application[]
  reviewed     Application[] @relation("ApplicationReviewer")
  auditLogs    AuditLog[]
}

// ---------------------------------------------------------------------------
// Public records
// ---------------------------------------------------------------------------

model Fighter {
  id   String @id @default(cuid())
  /// Public URL segment. Slugs are for humans and may change; use `id` for mutations.
  slug String @unique

  // ADMIN-owned (ADR 0003 §2)
  firstName   String
  lastName    String
  nickname    String?
  weightClass WeightClass?
  /// Admin-owned: it governs division eligibility, so it is not fighter-editable.
  gender      Gender?

  // FIGHTER-owned, publicly readable
  dob            DateTime?
  heightCm       Int?
  reachCm        Int?
  stance         Stance?
  primaryStyle   Discipline?
  secondaryStyle Discipline?
  gym            String?
  hometown       String?
  bio            String?
  /// Storage key, not a URL — the CDN domain can change without a data migration (§7).
  photoKey     String?
  instagramUrl String?
  facebookUrl  String?
  xUrl         String?

  // Record carried in from other promotions. The NMFC portion of a fighter's record is
  // derived from Fight rows; the displayed record is prior + derived (§3.3).
  priorWins   Int @default(0)
  priorLosses Int @default(0)
  priorDraws  Int @default(0)

  // Account binding. Admins create the record; the fighter claims it (ADR 0003 §1).
  user        User?       @relation(fields: [userId], references: [id])
  userId      String?     @unique
  claimStatus ClaimStatus @default(UNCLAIMED)

  /// Set when this fighter came from an accepted application. Nullable because the
  /// ADR 0003 route — admin creates the record directly, fighter claims it — is
  /// still supported and produces no application (ADR 0004 §1).
  application   Application? @relation(fields: [applicationId], references: [id])
  applicationId String?      @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile   FighterProfile?
  fightsAsA Fight[]         @relation("FighterA")
  fightsAsB Fight[]         @relation("FighterB")
  rankings  Ranking[]

  @@index([weightClass])
  @@index([lastName])
}

model Event {
  id   String @id @default(cuid())
  slug String @unique

  name      String
  date      DateTime
  venue     String?
  status    EventStatus @default(SCHEDULED)
  /// Storage key, not a URL (§7).
  posterKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fights Fight[]

  @@index([date])
}

model Fight {
  id String @id @default(cuid())

  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId String

  fighterA   Fighter @relation("FighterA", fields: [fighterAId], references: [id])
  fighterAId String
  fighterB   Fighter @relation("FighterB", fields: [fighterBId], references: [id])
  fighterBId String

  weightClass WeightClass?
  /// Display order on the card; highest is the main event. Deliberately not unique —
  /// a unique constraint makes reordering a card collide mid-update (§3.2).
  boutOrder    Int     @default(0)
  isTitleFight Boolean @default(false)

  status  FightStatus   @default(SCHEDULED)
  outcome FightOutcome?
  method  String?
  round   Int?
  time    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@index([fighterAId])
  @@index([fighterBId])
}

/// Manually ordered per division (§6). Rank uniqueness is enforced by the service on
/// write, not by the database — a unique constraint turns any reorder into a
/// constraint dance (§3.2).
model Ranking {
  id String @id @default(cuid())

  fighter     Fighter     @relation(fields: [fighterId], references: [id], onDelete: Cascade)
  fighterId   String
  weightClass WeightClass
  rank        Int
  updatedAt   DateTime    @updatedAt

  @@unique([weightClass, fighterId])
  @@index([weightClass, rank])
}

// ---------------------------------------------------------------------------
// Private data
// ---------------------------------------------------------------------------

/// Personal data, deliberately split from the public Fighter record so that a public
/// query physically cannot return it (ADR 0003 §3).
///
/// NOT stored here, pending confirmation: ID documents and medical clearance. Those
/// carry materially higher DPDP Act obligations than contact details and should be
/// confirmed as necessary before being collected (ADR 0003, Open).
model FighterProfile {
  id        String  @id @default(cuid())
  fighter   Fighter @relation(fields: [fighterId], references: [id], onDelete: Cascade)
  fighterId String  @unique

  // FIGHTER write, FIGHTER+ADMIN read
  phone             String?
  addressLine1      String?
  addressLine2      String?
  city              String?
  state             String?
  postalCode        String?
  country           String?
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?

  // ADMIN write, ADMIN read
  adminNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Applications (ADR 0004)
// ---------------------------------------------------------------------------

/// A submission to the NMFC Standard Fighter Eligibility Form.
///
/// **This model has no public endpoint — not a filtered one, none.** That is what keeps
/// ADR 0003's guarantee intact under open intake: an unreviewed or rejected applicant
/// cannot surface anywhere on the public site, because only an admin accepting an
/// application mints a `Fighter`.
///
/// Not stored here, deliberately:
///   - **Age** — derived from `dob`; a stored age goes stale.
///   - **Total fights** — `claimedWins + claimedLosses + claimedDraws`.
///   - **Minimum-gate eligibility** — computed from the answers below, not a flag.
model Application {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  status ApplicationStatus @default(DRAFT)

  // --- §1 Personal information -------------------------------------------
  firstName    String
  lastName     String
  dob          DateTime
  gender       Gender
  nationality  String
  city         String
  state        String?
  country      String
  phone        String
  email        String
  instagramUrl String?
  facebookUrl  String?
  xUrl         String?

  emergencyName     String
  emergencyPhone    String
  emergencyRelation String?

  // --- §2 + §6 Fighter profile and physicals ------------------------------
  // Height, reach and weight class are asked more than once on the form; they are
  // stored once here (ADR 0004 §4).
  nickname             String?
  primaryStyle         Discipline
  secondaryStyle       Discipline?
  desiredWeightClass   WeightClass
  heightCm             Int
  reachCm              Int
  walkingWeightKg      Decimal           @db.Decimal(5, 2)
  competitionWeightKg  Decimal           @db.Decimal(5, 2)
  legLengthCm          Int?
  stance               Stance
  yearsExperience      Int
  trainingDaysPerWeek  Int
  conditioning         ConditioningLevel

  gym        String
  headCoach  String
  coachPhone String?
  coachEmail String?

  // --- §4 Competition record — SELF-REPORTED ------------------------------
  // Every field below is an assertion by the applicant, never an official record.
  // On acceptance an admin transcribes what they have verified into `Fighter.prior*`
  // as a deliberate, audited act. Nothing here is copied automatically (ADR 0004 §2).
  claimedWins            Int       @default(0)
  claimedLosses          Int       @default(0)
  claimedDraws           Int       @default(0)
  claimedKoWins          Int       @default(0)
  claimedDecisionWins    Int       @default(0)
  claimedSubmissionWins  Int       @default(0)
  claimedAmateurRecord   String?
  claimedProRecord       String?
  lastFightDate          DateTime?
  nextFightDate          DateTime?
  honours                String?
  currentPromotion       String?

  // --- §5 Eligibility -----------------------------------------------------
  medicallyCleared          Boolean
  underSuspension           Boolean
  contractualRestriction    Boolean
  willingMedicalScreening   Boolean
  willingScouting           Boolean
  willingSparringEvaluation Boolean
  willingComplyRules        Boolean
  willingAccurateRecords    Boolean

  // --- §7 Self-assessed attributes ----------------------------------------
  attributes FightAttribute[]

  // --- §9 Coach verification ----------------------------------------------
  // Applicant-entered. This is NOT independent verification — see ADR 0004, Open.
  coachYearsWithFighter Int?
  coachAssessment       String?
  coachVerifiedRecord   Boolean @default(false)

  // --- §10 Declarations ---------------------------------------------------
  declaredAccurate        Boolean  @default(false)
  ackIndependentMedical   Boolean  @default(false)
  ackNoGuarantee          Boolean  @default(false)
  agreedSafetyRules       Boolean  @default(false)
  /// Consent timestamp for DPDP purposes; set when all four are affirmed.
  declarationsAcceptedAt  DateTime?

  // --- §11 Fighter declaration --------------------------------------------
  motivation        String?
  careerGoals       String?
  differentiator    String?
  influence         String?
  willingToRelocate Boolean @default(false)

  // --- Review -------------------------------------------------------------
  submittedAt     DateTime?
  reviewedBy      User?     @relation("ApplicationReviewer", fields: [reviewedById], references: [id])
  reviewedById    String?
  reviewedAt      DateTime?
  reviewNotes     String?
  rejectionReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  experience ApplicationExperience[]
  videos     ApplicationVideo[]
  fighter    Fighter?

  @@index([userId])
  @@index([status, submittedAt])
}

/// §3 combat-sports background, one row per discipline. A child table rather than
/// eight columns, so adding a discipline is data rather than a migration.
model ApplicationExperience {
  id            String      @id @default(cuid())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  discipline    Discipline
  years         Int
  record        String?
  notes         String?

  @@unique([applicationId, discipline])
}

/// §8 video submissions. Links only — NMFC hosts no footage at application stage,
/// which avoids transcoding cost and the retention problem for rejected applicants
/// (ADR 0004 §6). Links rot, so anything decisive should be captured during review.
model ApplicationVideo {
  id            String      @id @default(cuid())
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  kind          VideoKind
  url           String
  label         String?
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}

/// Field-level change history. Fighters edit their own profiles and publish immediately,
/// so oversight is after the fact: log every change, let admins revert (ADR 0003 §4).
model AuditLog {
  id String @id @default(cuid())

  actor   User?   @relation(fields: [actorId], references: [id])
  /// Null for changes made by the system rather than a signed-in user.
  actorId String?

  entity   String
  entityId String
  field    String
  before   String?
  after    String?

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}
