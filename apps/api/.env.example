# Local development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nmfc?schema=public"
PORT=4000

# Comma-separated allowlist. Required in production; omit locally to reflect any origin.
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# --- Production (set via `fly secrets set`, never committed) ---
#
# Use Supabase's SESSION POOLER connection string, not the direct one.
# Prisma opens a pool per instance; direct connections exhaust Postgres
# limits as soon as you run more than one machine.
# Supabase dashboard → Project Settings → Database → Connection string → Session pooler
#
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"
# CORS_ORIGINS="https://nmfc.example.com"
#
# Auth is Identity Platform (ADR 0004), not Supabase Auth. Fastify verifies the JWT.
# FIREBASE_PROJECT_ID="..."
# FIREBASE_AUDIENCE="..."   # typically the web/API client ID / project ID used as aud
