# Local development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nmfc?schema=public"
PORT=4000

# Comma-separated allowlist. Required in production; omit locally to reflect any origin.
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"

# --- Production: Google Cloud (ADR 0005) ---------------------------------------
#
# Set via Secret Manager and referenced by the Cloud Run service — never committed.
# See docs/deployment-gcp.md for the provisioning runbook.
#
# Cloud Run reaches Cloud SQL over a Unix socket, not TCP. The socket path goes in the
# `host` query parameter and the authority part is ignored:
#
# DATABASE_URL="postgresql://nmfc:PASSWORD@localhost/nmfc?host=/cloudsql/PROJECT_ID:asia-south1:nmfc-db"
#
# Once Cloud SQL Managed Connection Pooling is enabled, point DATABASE_URL at the pooler
# rather than the instance directly. Pooling is not optional at more than one instance:
# Prisma opens a pool per container, so a fight-night scale-out exhausts Postgres
# connections long before CPU. Confirm the exact endpoint form against current Cloud SQL
# docs at provisioning time.
#
# PORT is injected by Cloud Run — do not set it.
# CORS_ORIGINS="https://nmfc.example.com"
